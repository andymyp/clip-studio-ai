# Application
APP_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=8080
WORKER_API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8080

# PostgreSQL
POSTGRES_USER=clipstudio
POSTGRES_PASSWORD=clipstudio
POSTGRES_DB=clipstudio
POSTGRES_PORT=5432
DATABASE_URL=postgres://clipstudio:clipstudio@postgres:5432/clipstudio?sslmode=disable

# Redis / asynchronous jobs
REDIS_PORT=6379
REDIS_ADDR=redis:6379
REDIS_URL=redis://redis:6379/0
ASYNQ_QUEUE=default

# Internal services
WORKER_API_URL=http://worker-api:8000
OLLAMA_HOST=http://ollama:11434
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2

# Storage
STORAGE_PATH=/app/storage
