# Python worker API and background worker configuration for local terminal development.

# APP
APP_ENV=development
STORAGE_PATH=../../storage

# REDIS
REDIS_URL=redis://localhost:6379/0

# OLLAMA
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# CLIP ANALYSIS
TRANSCRIPT_LANGUAGE=en
YTDLP_JS_RUNTIME=node
YTDLP_IMPERSONATE=chrome
# Local path; Docker Compose overrides it with /run/secrets/youtube_cookies.
YTDLP_COOKIE_FILE=../../storage/secrets/youtube-cookies.txt
YTDLP_SLEEP_REQUESTS=2
YTDLP_SLEEP_SUBTITLES=5
CLIP_MIN_DURATION=20
CLIP_MAX_DURATION=60
CLIP_MAX_CANDIDATES=5
CLIP_CONTEXT_BEFORE=2
CLIP_CONTEXT_AFTER=1.2
JOB_QUEUE_NAME=clipstudio:analysis:queue
RENDER_QUEUE_NAME=clipstudio:render:queue
REVIEW_CLEANUP_INTERVAL_SECONDS=300

# WHISPER
WHISPER_MODEL=small
