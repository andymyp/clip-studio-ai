# Go backend configuration for local terminal development.

# APP
APP_ENV=development
PORT=3001
STORAGE_PATH=../storage
WORKER_API_URL=http://localhost:3002

# DATABASE
DATABASE_URL=postgres://clipstudio:clipstudio@localhost:5432/clipstudio?sslmode=disable
AUTO_MIGRATE=true
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# REDIS
REDIS_ADDR=localhost:6379
ASYNQ_QUEUE=default
