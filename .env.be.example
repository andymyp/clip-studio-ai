# Go backend configuration for local terminal development.

# APP
APP_ENV=development
PORT=3001
SHUTDOWN_TIMEOUT=10s
STORAGE_PATH=../../storage
WORKER_API_URL=http://localhost:3002

# DATABASE
DATABASE_URL=postgres://clipstudio:clipstudio@localhost:5432/clipstudio?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
AUTO_MIGRATE=true

# REDIS
REDIS_ADDR=localhost:6379
ASYNQ_QUEUE=default

# AUTHENTICATION
# Use a randomly generated secret containing at least 32 characters.
JWT_SECRET=development-only-change-this-secret
JWT_ISSUER=clipstudio-ai
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
BCRYPT_COST=12

# VIDEO DISCOVERY
# Create a YouTube Data API v3 key in Google Cloud Console.
ENABLE_YOUTUBE_API=true
YOUTUBE_API_KEY=
# Leave empty for global discovery.
YOUTUBE_REGION=
YOUTUBE_LANGUAGE=en
YOUTUBE_DISCOVERY_QUERY=podcast|interview|education|business|technology|science|story|debate|speech|documentary|inspiration
YOUTUBE_REUSABLE_ONLY=true
YOUTUBE_EXCLUDE_MUSIC=true
YOUTUBE_EXCLUDED_TERMS=religion,religious,faith,church,christian,muslim,islam,hindu,politics,political,election,war,weapon,gun,violence,violent,crime,murder,adult,sexual,gambling,casino,drug
YOUTUBE_DISCOVERY_DAYS=30
YOUTUBE_MIN_DURATION_SECONDS=180
# Create a Reddit "script" application and use application-only OAuth credentials.
ENABLE_REDDIT_API=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:clipstudio-ai:v0.1.0
DISCOVERY_MIN_RESULTS=10
DISCOVERY_LIMIT=20
DISCOVERY_TIMEOUT=12s
DISCOVERY_CACHE_TTL=6h
