# Go backend configuration for local terminal development.

# APP
APP_ENV=development
PORT=3001
SHUTDOWN_TIMEOUT=10s
STORAGE_PATH=../../storage
WORKER_API_URL=http://localhost:3002

# DATABASE
DATABASE_URL=postgres://clipstudio:clipstudio@localhost:5432/clipstudio?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
AUTO_MIGRATE=true

# REDIS
REDIS_ADDR=localhost:6379
ASYNQ_QUEUE=default

# AUTHENTICATION
# Use a randomly generated secret containing at least 32 characters.
JWT_SECRET=development-only-change-this-secret
JWT_ISSUER=clipstudio-ai
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
BCRYPT_COST=12
